#!/bin/sh
# Herdr's PATH under launchd leaves out Homebrew, so its usual places are tried too.
dir=$(dirname "$0")
for python in "${KEY_HINTS_PYTHON:-}" python3 /opt/homebrew/bin/python3 /usr/local/bin/python3 \
    python3.15 python3.14 python3.13 python3.12 python3.11; do
    [ -n "$python" ] || continue
    command -v "$python" >/dev/null 2>&1 || continue
    if "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        exec "$python" "$dir/key_hints.py" "$@"
    fi
done
echo "key-hints needs Python 3.11 or newer, for tomllib. Install one, or set KEY_HINTS_PYTHON to it." >&2
exit 1
