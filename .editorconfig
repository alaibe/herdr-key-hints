# The shared code standard: homeserver's AGENTS.md › Code standards.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.{swift,py,sh}]
indent_size = 4

# The shell script that starts Python has no extension.
[run]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
